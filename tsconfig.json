{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true
  },
  "include": ["*.ts", "tests/**/*.ts", "server/**/*.ts", "shared/**/*.ts"]
}
